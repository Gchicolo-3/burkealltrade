# Which client config in /clients this deployment runs
CLIENT_ID=burke

# Postgres (Neon via Vercel Storage, or Supabase pooled connection string)
DATABASE_URL=

# Auth.js
AUTH_SECRET=            # openssl rand -base64 32
AUTH_GOOGLE_ID=         # Google Cloud OAuth client ID
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=         # comma separated Google accounts allowed to sign in

# AI, server side only. George's key, never the client's.
ANTHROPIC_API_KEY=
